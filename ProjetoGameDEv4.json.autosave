50","1"]}],"events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["let listaPerguntas = runtimeScene.getVariables().get(\"listaPerguntas\");","let listaRespostas = runtimeScene.getVariables().get(\"listaRespostas\");","let total = runtimeScene.getVariables().get(\"total\");","","let cidadeAtual = runtimeScene.getGame().getVariables().get(\"cidade_atual\").getAsString(); // Recupera a cidade atual","","let textoPergunta = runtimeScene.getObjects(\"texto_pergunta\");","let textoCidade = runtimeScene.getObjects(\"texto_cidade_atual\");","let textoTotal = runtimeScene.getObjects(\"texto_total\");","","let dados_perguntas = [];","let dados_respostas = [];","console.log(\"entrando no quiz\");","","switch (cidadeAtual) {","    case \"Teresina\":","        console.log(\"entrando no case teresina\");","        dados_perguntas = [","            {\"pergunta\": \"Quem realizou a mudança da capital do Piauí de Oeiras para Teresina?\"},","            {\"pergunta\": \"Qual bairro é considerado o primeiro bairro de Teresina?\"},","            {\"pergunta\": \"Em que ano Teresina foi oficialmente fundada?\"},","            {\"pergunta\": \"Qual foi a primeira capital do Piauí antes de Teresina?\"},","            {\"pergunta\": \"Qual é o nome da ponte mais famosa de Teresina, considerada um símbolo da cidade?\"},","            {\"pergunta\": \"Qual rio corta a cidade de Teresina, sendo importante para sua economia e urbanização?\"}","        ];","        console.log(\"cidade teresina switch\");","","        dados_respostas = [","            {","                \"a\": \"Dom Pedro II\",","                \"b\": \"João Isidoro França\",","                \"c\": \"Simplício Mendes\",","                \"d\": \"José Antônio Saraiva\",","                \"r\": \"José Antônio Saraiva\",","                \"explicacoes\": {","                    \"a\": \"Dom Pedro II foi o imperador na época, mas não foi responsável pela mudança da capital.\",","                    \"b\": \"João Isidoro França foi o engenheiro responsável pelo planejamento de Teresina, mas não fez a mudança.\",","                    \"c\": \"Simplício Mendes não esteve envolvido na transferência da capital.\",","                    \"d\": \"José Antônio Saraiva foi o presidente da província que realizou a mudança da capital de Oeiras para Teresina.\"","                }","            },","            {","                \"a\": \"Mafuá\",","                \"b\": \"Piçarra\",","                \"c\": \"Poty Velho\",","                \"d\": \"Cajueiro\",","                \"r\": \"Poty Velho\",","                \"explicacoes\": {","                    \"a\": \"Mafuá é um bairro tradicional, mas não o primeiro de Teresina.\",","                    \"b\": \"Piçarra também é um bairro antigo, mas não o mais antigo.\",","                    \"c\": \"Poty Velho é o bairro mais antigo de Teresina, originando-se com a fundação da cidade.\",","                    \"d\": \"Cajueiro é um bairro de Teresina, mas não foi o primeiro.\"","                }","            },","            {","                \"a\": \"1842\",","                \"b\": \"1852\",","                \"c\": \"1862\",","                \"d\": \"1872\",","                \"r\": \"1852\",","                \"explicacoes\": {","                    \"a\": \"1842 é uma data antes da fundação de Teresina.\",","                    \"b\": \"1852 é o ano correto da fundação da cidade.\",","                    \"c\": \"1862 foi 10 anos após a fundação de Teresina.\",","                    \"d\": \"1872 é uma data posterior à fundação de Teresina.\"","                }","            },","            {","                \"a\": \"Parnaíba\",","                \"b\": \"Floriano\",","                \"c\": \"São Raimundo Nonato\",","                \"d\": \"Oeiras\",","                \"r\": \"Oeiras\",","                \"explicacoes\": {","                    \"a\": \"Parnaíba é uma cidade importante, mas nunca foi capital do Piauí.\",","                    \"b\": \"Floriano nunca foi capital do Piauí.\",","                    \"c\": \"São Raimundo Nonato é conhecida pelos sítios arqueológicos, mas nunca foi capital.\",","                    \"d\": \"Oeiras foi a primeira capital do Piauí até 1852.\"","                }","            },","            {","                \"a\": \"Ponte Juscelino Kubitschek\",","                \"b\": \"Ponte Estaiada João Isidoro França\",","                \"c\": \"Ponte Metálica\",","                \"d\": \"Ponte da Amizade\",","                \"r\": \"Ponte Estaiada João Isidoro França\",","                \"explicacoes\": {","                    \"a\": \"Ponte Juscelino Kubitschek é uma ponte importante, mas está localizada em Brasília.\",","                    \"b\": \"Ponte Estaiada João Isidoro França é o principal cartão postal de Teresina.\",","                    \"c\": \"A Ponte Metálica é uma ponte histórica, mas não é considerada o símbolo mais famoso.\",","                    \"d\": \"Ponte da Amizade existe, mas não é o símbolo mais conhecido de Teresina.\"","                }","            },","            {","                \"a\": \"Rio Poti\",","                \"b\": \"Rio Parnaíba\",","                \"c\": \"Rio São Francisco\",","                \"d\": \"Rio Gurguéia\",","                \"r\": \"Rio Poti\",","                \"explicacoes\": {","                    \"a\": \"Rio Poti é um dos rios que corta Teresina, sendo o mais importante para a urbanização da cidade.\",","                    \"b\": \"Rio Parnaíba é importante, mas o Rio Poti tem mais relevância dentro de Teresina.\",","                    \"c\": \"O Rio São Francisco não passa por Teresina.\",","                    \"d\": \"O Rio Gurguéia está localizado em outra região do Piauí.\"","                }","            }","        ];","        break;","","    case \"Oeiras\":","        dados_perguntas = [","            {\"pergunta\": \"Qual foi o primeiro presidente da província do Piauí?\"}, ","            {\"pergunta\": \"Em que ano Oeiras foi fundada oficialmente?\"}, ","            {\"pergunta\": \"Qual é o nome da igreja histórica mais importante de Oeiras?\"}, ","            {\"pergunta\": \"Qual foi a principal atividade econômica de Oeiras no século XIX?\"}, ","            {\"pergunta\": \"Qual monumento ou conjunto arquitetônico de Oeiras é tombado como patrimônio histórico?\"}, ","            {\"pergunta\": \"Quando Oeiras deixou de ser a capital do Piauí?\"}","            // outras perguntas de Oeiras...","        ];","","        dados_respostas = [","            {","                \"a\": \"Domingos Jorge Velho\",","                \"b\": \"João José da Silva\",","                \"c\": \"Pedro II\",","                \"d\": \"Luís do Rego Barreto\",","                \"r\": \"João José da Silva\",","                \"explicacoes\": {","                    \"a\": \"Domingos Jorge Velho foi um bandeirante.\",","                    \"b\": \"João José da Silva foi o primeiro presidente.\",","                    \"c\": \"Pedro II foi o imperador do Brasil, mas não esteve diretamente envolvido no Piauí.\",","                    \"d\": \"Luís do Rego Barreto foi governador de Pernambuco\"","                }","            },","             {","                \"a\": \"1697\",","                \"b\": \"1723\",","                \"c\": \"1750\",","                \"d\": \"1800\",","                \"r\": \"1697\",","                \"explicacoes\": {","                    \"a\": \"Resposta Correta: 1697 é o ano da fundação oficial de Oeiras.\",","                    \"b\": \"1723 é uma data posterior, e a cidade já estava consolidada.\",","                    \"c\": \"1750 é incorreto, pois a cidade já existia.\",","                    \"d\": \"1800 é muito depois da fundação.\"","                }","            },","             {","                \"a\": \"Igreja de São Francisco\",","                \"b\": \"Igreja de Nossa Senhora da Vitória\",","                \"c\": \"Igreja São Benedito\",","                \"d\": \"Igreja de São Raimundo Nonato\",","                \"r\": \"Igreja de Nossa Senhora da Vitória\",","                \"explicacoes\": {","                    \"a\": \"Igreja de São Francisco está localizada em outro estado.\",","                    \"b\": \"A Igreja de Nossa Senhora da Vitória é o principal monumento religioso de Oeiras.\",","                    \"c\": \"A Igreja de São Benedito está localizada na capital do Piauí.\",","                    \"d\": \"A Igreja de São Raimundo Nonato está em outra cidade.\"","                }","            },","             {","                \"a\": \"Mineração de ouro\",","                \"b\": \"Pecuária\",","                \"c\": \"Indústria têxtil\",","                \"d\": \"Produção de algodão\",","                \"r\": \"Produção de algodão\",","                \"explicacoes\": {","                    \"a\": \"Mineração de ouro não foi uma atividade relevante na região.\",","                    \"b\": \"Pecuária existia, mas não foi a principal atividade.\",","                    \"c\": \"A indústria têxtil se desenvolveu em outras áreas.\",","                    \"d\": \"A produção de algodão foi uma das principais fontes de renda da cidade no século XIX.\"","                }","            },","             {","                \"a\": \"Sítios Arqueológicos de Oeiras\",","                \"b\": \"Palácio de Karnak\",","                \"c\": \"Centro Histórico de Oeiras\",","                \"d\": \"Ponte Metálica\",","                \"r\": \"Centro Histórico de Oeiras\",","                \"explicacoes\": {","                    \"a\": \"Oeiras não é conhecida por seus sítios arqueológicos.\",","                    \"b\": \"O Palácio de Karnak está em Teresina.\",","                    \"c\": \"O Centro Histórico de Oeiras é tombado pelo IPHAN como patrimônio nacional.\",","                    \"d\": \"A Ponte Metálica está entre Timon e Teresina.\"","                }","            },","             {","                \"a\": \"1850\",","                \"b\": \"1852\",","                \"c\": \"1860\",","                \"d\": \"1872\",","                \"r\": \"1852\",","                \"explicacoes\": {","                    \"a\": \"1850 é um pouco antes da transferência da capital.\",","                    \"b\": \"1852 foi o ano da mudança da capital para Teresina.\",","                    \"c\": \"1860 é posterior à mudança.\",","                    \"d\": \"1872 é muito depois da transferência.\"","                }","            }","            // outras respostas de Oeiras...","        ];","        break;","","    case \"Parnaíba\":","        dados_perguntas = [","            {\"pergunta\": \"Qual é o apelido de Parnaíba, devido à sua localização?\"}, ","            {\"pergunta\": \"Em que data a cidade de Parnaíba foi oficialmente fundada?\"}, ","            {\"pergunta\": \"Domingos Dias da Silva foi um personagem importante na história de Parnaíba devido ao seu papel como:\"}, ","            {\"pergunta\": \"Qual povo indígena habitava a região onde hoje está localizada a cidade de Parnaíba?\"}, ","            {\"pergunta\": \"Qual é o nome do rio que passa pelo Porto das Barcas de Parnaíba?\"} , ","            {\"pergunta\": \"Quando a cidade de Luís Correia foi emancipada?\"} ","            ","        ];","","        dados_respostas = [","            {","                \"a\": \"Capital do Sertão\",","                \"b\": \"Capital do Litoral\",","                \"c\": \"Capital do Sol\",","                \"d\": \"Capital do Delta\",","                \"r\": \"Capital do Delta\",","                \"explicacoes\": {","                    \"a\": \"Resposta Incorreta\",","                    \"b\": \"Resposta Incorreta\",","                    \"c\": \"Resposta Incorreta\",","                    \"d\": \"Resposta Correta\"                    ","                }               ","            },","            {","                \"a\": \"1º de janeiro de 1822\",","                \"b\": \"14 de agosto de 1844\",","                \"c\": \"7 de setembro de 1850\",","                \"d\": \"15 de novembro de 1889\",","                \"r\": \"14 de agosto de 1844\",","                \"explicacoes\": {","                    \"a\": \"Resposta Incorreta \",","                    \"b\": \"Resposta Correta \",","                    \"c\": \"Resposta Incorreta\",","                    \"d\": \"Resposta Inconrreta\"                    ","                }               ","            },","            {","                \"a\": \"Líder político\",","                \"b\": \"Missionário\",","                \"c\": \"Proprietário de terras e comerciante\",","                \"d\": \"Explorador\",","                \"r\": \"Proprietário de terras e comerciante\",","                \"explicacoes\": {","                    \"a\": \"Resposta Incorreta\",","                    \"b\": \"Resposta Incorreta\",","                    \"c\": \"Resposta Correta\",","                    \"d\": \"Resposta Incorreta\"                    ","                }               ","            },","            {","                \"a\": \"Tupi\",","                \"b\": \"Tremembé\",","                \"c\": \"Guarani\",","                \"d\": \"Paramirin\",","                \"r\": \"Tremembé\",","                \"explicacoes\": {","                    \"a\": \"Resposta Incorreta\",","                    \"b\": \"Resposta Correta\",","                    \"c\": \"Resposta Incorreta\",","                    \"d\": \"Resposta Incorreta\"                    ","                }               ","            }","            ,","            {","                \"a\": \"Rio Amazonas\",","                \"b\": \"Rio São Francisco\",","                \"c\": \"Rio Igaraçu\",","                \"d\": \"Rio Tocantins\",","                \"r\": \"Rio Igaraçu\",","                \"explicacoes\": {","                    \"a\": \"Resposta Incorreta\",","                    \"b\": \"Resposta Incorreta\",","                    \"c\": \"Resposta Correta\",","                    \"d\": \"Resposta Incorreta\"                    ","                }               ","            },","            {","                \"a\": \"1º de janeiro de 1822\",","                \"b\": \"26 de julho de 1938\",","                \"c\": \"7 de setembro de 1950\",","                \"d\": \"15 de novembro de 1920\",","                \"r\": \"26 de julho de 1938\",","                \"explicacoes\": {","                    \"a\": \"Resposta Incorreta \",","                    \"b\": \"Resposta Correta \",","                    \"c\": \"Resposta Incorreta\",","                    \"d\": \"Resposta Inconrreta\"                    ","                }               ","            }","           ","        ];","        break;","","    case \"Campo Maior\":","        dados_perguntas = [","            {\"pergunta\": \"Qual evento histórico em Campo Maior foi fundamental para a independência do Brasil no Piauí?\"}, ","            {\"pergunta\": \"Em que ano ocorreu a Batalha do Jenipapo?\"}, ","            {\"pergunta\": \"Qual é o principal monumento em Campo Maior que homenageia os heróis da Batalha do Jenipapo?\"}, ","            {\"pergunta\": \"Quando Campo Maior foi elevada à categoria de cidade?\"}, ","            {\"pergunta\": \"Qual foi a principal atividade econômica de Campo Maior no início de sua história?\"}, ","            {\"pergunta\": \"Que papel Campo Maior teve na luta pela Independência do Brasil?\"} ","            // outras perguntas de Campo Maior...","        ];","","        dados_respostas = [","            {","                \"a\": \"Revolta de Canudos\",","                \"b\": \"Guerra dos Emboabas\",","                \"c\": \"Inconfidência Mineira\",","                \"d\": \"Batalha do Jenipapo\",","                \"r\": \"Batalha do Jenipapo\",","                \"explicacoes\": {","                    \"a\": \"Revolta de Canudos ocorreu na Bahia.\",","                    \"b\": \"A Guerra dos Emboabas ocorreu em Minas Gerais.\",","                    \"c\": \"A Inconfidência Mineira ocorreu em Minas Gerais e não tem relação com Campo Maior.\",","                    \"d\": \"A Batalha do Jenipapo foi crucial para a independência no Piauí.\"","                }","            },","             {","                \"a\": \"1820\",","                \"b\": \"1821\",","                \"c\": \"1823\",","                \"d\": \"1825\",","                \"r\": \"1823\",","                \"explicacoes\": {","                    \"a\": \"1820 foi antes da Independência do Brasil.\",","                    \"b\": \"1821 é anterior ao evento.\",","                    \"c\": \"1823 foi o ano correto da Batalha do Jenipapo.\",","                    \"d\": \"1825 é posterior ao evento.\"","                }","            },","             {","                \"a\": \"Monumento aos Heróis do Jenipapo\",","                \"b\": \" Obelisco da Independência\",","                \"c\": \"Monumento do Jenipapo\",","                \"d\": \"Estátua da Liberdade\",","                \"r\": \"Monumento aos Heróis do Jenipapo\",","                \"explicacoes\": {","                    \"a\": \"Este Monumento foi erguido em Campo Maior para homenagear os combatentes.\",","                    \"b\": \"O obelisco da Independência está em São Paulo.\",","                    \"c\": \"Não é esse o nome correto do monumento\",","                    \"d\": \"A Estátua da Liberdade está nos EUA, sem relação com Campo Maior.\"","                }","            },","             {","                \"a\": \"1762\",","                \"b\": \"1823\",","                \"c\": \"1861\",","                \"d\": \"1910\",","                \"r\": \"1861\",","                \"explicacoes\": {","                    \"a\": \"1762 foi o ano de fundação, mas não de elevação a cidade.\",","                    \"b\": \"1823 foi o ano da Batalha do Jenipapo, mas não de elevação a cidade.\",","                    \"c\": \"Em 1861, Campo Maior foi elevada à categoria de cidade.\",","                    \"d\": \"1910 é muito posterior ao evento.\"","                }","            },","             {","                \"a\": \"Mineração de ouro\",","                \"b\": \"Produção de café\",","                \"c\": \"Comércio de açúcar\",","                \"d\": \"Extração de carnaúba\",","                \"r\": \"Extração de carnaúba\",","                \"explicacoes\": {","                    \"a\": \"Mineração de ouro não foi relevante para a cidade.\",","                    \"b\": \"A produção de café não era destaque em Campo Maior.\",","                    \"c\": \"O comércio de açúcar não foi significativo na cidade.\",","                    \"d\": \"A extração de carnaúba foi uma das principais atividades econômicas de Campo Maior.\"","                }","            },","             {","                \"a\": \"Foi o local de nascimento de Dom Pedro I.\",","                \"b\": \"Tornou-se um centro de resistência contra tropas portuguesas.\",","                \"c\": \"Foi o local onde ocorreu a assinatura da independência do Brasil.\",","                \"d\": \"Abrigou a sede do governo provisório do Piauí após a independência.\",","                \"r\": \"Tornou-se um centro de resistência contra tropas portuguesas.\",","                \"explicacoes\": {","                    \"a\": \"Dom Pedro I nasceu em Portugal, não em Campo Maior.\",","                    \"b\": \"A cidade foi um ponto importante de resistência na Batalha do Jenipapo.\",","                    \"c\": \"A assinatura da independência ocorreu no Rio de Janeiro.\",","                    \"d\": \"A sede do governo provisório não esteve em Campo Maior.\"","                }","            }","            // outras respostas de Campo Maior...","        ];","        break;","","    case \"São Raimundo Nonato\":","        dados_perguntas = [","            {\"pergunta\": \"Em que ano o Parque Nacional Serra da Capivara foi criado?\"}, ","            {\"pergunta\": \"Qual é o principal atrativo arqueológico de São Raimundo Nonato?\"}, ","            {\"pergunta\": \"O Parque Nacional Serra da Capivara é reconhecido por qual organização internacional?\"}, ","            {\"pergunta\": \"Qual a importância do Museu do Homem Americano em São Raimundo Nonato?\"}, ","            {\"pergunta\": \"Qual é a evidência mais antiga encontrada na Serra da Capivara sobre a presença humana?\"}, ","            {\"pergunta\": \"O Parque Nacional Serra da Capivara foi criado com que objetivo principal?\"}","            // outras perguntas de São Raimundo Nonato...","        ];","","        dados_respostas = [","            {","                \"a\": \"1979\",","                \"b\": \"1985\",","                \"c\": \"1990\",","                \"d\": \"1995\",","                \"r\": \"1979\",","                \"explicacoes\": {","                    \"a\": \"Resposta Correta: 1979 é o ano correto de criação do Parque.\",","                    \"b\": \"1985 é uma data incorreta.\",","                    \"c\": \"1990 não está relacionado à criação do Parque.\",","                    \"d\": \"1995 é uma data posterior ao evento.\"","                }","            },","            {","                \"a\": \"emplos Incas\",","                \"b\": \"Pinturas Rupestres\",","                \"c\": \"Pirâmides\",","                \"d\": \"Ruínas de Palácios\",","                \"r\": \"Pinturas Rupestres\",","                \"explicacoes\": {","                    \"a\": \"Templos Incas estão na América do Sul, mas fora do Brasil.\",","                    \"b\": \"As pinturas rupestres da Serra da Capivara são o principal atrativo arqueológico.\",","                    \"c\": \"Pirâmides são encontradas no Egito e América Central, não no Piauí.\",","                    \"d\": \"Não há ruínas de palácios na região.\"","                }","            },","            {","                \"a\": \"ONU\",","                \"b\": \"NASA\",","                \"c\": \"Greenpeace\",","                \"d\": \"UNESCO\",","                \"r\": \"UNESCO\",","                \"explicacoes\": {","                    \"a\": \"A ONU engloba várias áreas, mas não é essa a organização específica.\",","                    \"b\": \"NASA é uma agência espacial e não está relacionada ao reconhecimento cultural.\",","                    \"c\": \"Greenpeace é uma ONG ambiental, sem relação com o reconhecimento do parque.\",","                    \"d\": \"A UNESCO reconheceu o parque como Patrimônio Mundial.\"","                }","            },","            {","                \"a\": \"Ele abriga artefatos arqueológicos e promove pesquisas sobre a presença humana na América.\",","                \"b\": \"Serve como sede de governo local.\",","                \"c\": \"Foi construído para homenagear reis e imperadores.\",","                \"d\": \"É um centro de estudos sobre a fauna e flora do Brasil.\",","                \"r\": \"Ele abriga artefatos arqueológicos e promove pesquisas sobre a presença humana na América.\",","                \"explicacoes\": {","                    \"a\": \"Ele abriga artefatos arqueológicos e promove pesquisas sobre a presença humana na América.\",","                    \"b\": \"Incorreta: Não é uma sede de governo.\",","                    \"c\": \"Incorreta: Não está relacionado a reis ou imperadores.\",","                    \"d\": \"Incorreta: O museu foca em arqueologia humana, não em fauna ou flora.\"","                }","            },","            {","                \"a\": \"Ferramentas de metal\",","                \"b\": \"Pirâmides de 10 mil anos\",","                \"c\": \"Pinturas Rupestres de até 50 mil anos\",","                \"d\": \"Esqueletos de 20 mil anos\",","                \"r\": \"Pinturas Rupestres de até 50 mil anos\",","                \"explicacoes\": {","                    \"a\": \"Incorreta: Ferramentas de metal não são as mais antigas, pois pertencem a períodos mais recentes.\",","                    \"b\": \"Incorreta: Não há pirâmides na Serra da Capivara.\",","                    \"c\": \"As pinturas rupestres são as evidências mais antigas encontradas.\",","                    \"d\": \"Incorreta: Esqueletos humanos são encontrados, mas não tão antigos quanto as pinturas.\"","                }","            },","            {","                \"a\": \"Proteger as espécies ameaçadas de extinção da região.\",","                \"b\": \"Preservar os sítios arqueológicos e pinturas rupestres.\",","                \"c\": \"Tornar-se uma área de cultivo agrícola.\",","                \"d\": \"Servir como reserva militar.\",","                \"r\": \"Preservar os sítios arqueológicos e pinturas rupestres.\",","                \"explicacoes\": {","                    \"a\": \"A fauna não é o principal foco do parque, mas sim os achados arqueológicos.\",","                    \"b\": \"O parque foi criado para preservar o patrimônio histórico e arqueológico.\",","                    \"c\": \"O parque não tem relação com atividades agrícolas.\",","                    \"d\": \"Não é uma área militar.\"","                }","            }","            // outras respostas de São Raimundo Nonato...","        ];","        break;","","    default:","        console.log(\"Cidade desconhecida\");","        break;","}","","","for(let i = 0; i< dados_perguntas.length; i++){","    listaPerguntas.getChild(i).getChild(\"pergunta\").setString(dados_perguntas[i].pergunta);","}","","for(let i = 0; i< dados_respostas.length; i++){","    listaRespostas.getChild(i).getChild(\"a\").setString(dados_respostas[i].a);","    listaRespostas.getChil