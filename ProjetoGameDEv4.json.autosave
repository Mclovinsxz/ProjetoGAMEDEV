,{"objectName":"texto_resposta2"},{"objectName":"texto_resposta3"},{"objectName":"texto_resposta4"},{"objectName":"texto_resposta_alternativa"},{"objectName":"texto_resposta_correta"},{"objectName":"acertos"},{"objectName":"texto_total"},{"objectName":"texto_titulo"},{"objectName":"texto_personagem"},{"objectName":"botão_seguinte"}]},"events":[{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"KeyReleased"},"parameters":["","Escape"]}],"actions":[{"type":{"value":"Quit"},"parameters":[""]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"DepartScene"},"parameters":[""]}],"actions":[{"type":{"value":"Cache"},"parameters":["balao_texto"]},{"type":{"value":"PauseTimer"},"parameters":["","\"correta\""]},{"type":{"value":"PauseTimer"},"parameters":["","\"incorreta\""]},{"type":{"value":"Cache"},"parameters":["botão_seguinte"]},{"type":{"value":"Cache"},"parameters":["texto_resposta_alternativa"]}],"events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["let listaPerguntas = runtimeScene.getVariables().get(\"listaPerguntas\");","let listaRespostas = runtimeScene.getVariables().get(\"listaRespostas\");","let total = runtimeScene.getVariables().get(\"total\");","","let textoPergunta = runtimeScene.getObjects(\"texto_pergunta\");","","let dados_perguntas = [","    {\"pergunta\": \"Quem realizou a mudança da capital do Piauí de Oeiras para Teresina?\"},","    {\"pergunta\": \"Qual bairro é considerado o primeiro bairro de Teresina?\"},","    {\"pergunta\": \"Em que ano Teresina foi oficialmente fundada?\"},","    {\"pergunta\": \"Qual foi a primeira capital do Piauí antes de Teresina?\"},","    {\"pergunta\": \"Qual é o nome da ponte mais famosa de Teresina, considerada um símbolo da cidade?\"},","    {\"pergunta\": \"Qual rio corta a cidade de Teresina, sendo importante para sua economia e urbanização?\"}","","]","","let dados_respostas = [","    {","        \"a\": \"Dom Pedro II\",","        \"b\": \"João Isidoro França\",","        \"c\": \"Simplício Mendes\",","        \"d\": \"José Antônio Saraiva\",","        \"r\": \"José Antônio Saraiva\",","         \"explicacoes\": {","            \"a\": \"Dom Pedro II foi o imperador na época, mas não foi responsável pela mudança da capital.\",","            \"b\": \"João Isidoro França foi o engenheiro responsável pelo planejamento de Teresina, mas não fez a mudança.\",","            \"c\": \"Simplício Mendes não esteve envolvido na transferência da capital.\",","            \"d\": \"José Antônio Saraiva foi o presidente da província que realizou a mudança da capital de Oeiras para Teresina.\"","        }","    },","     {","        \"a\": \"Mafuá\",","        \"b\": \"Piçarra\",","        \"c\": \"Poty Velho\",","        \"d\": \"Cajueiro\",","        \"r\": \"Poty Velho\",","        \"explicacoes\": {","            \"a\": \"Mafuá é um bairro tradicional, mas não o primeiro de Teresina.\",","            \"b\": \"Piçarra também é um bairro antigo, mas não o mais antigo.\",","            \"c\": \"Poty Velho é o bairro mais antigo de Teresina, originando-se com a fundação da cidade.\",","            \"d\": \"Cajueiro é um bairro de Teresina, mas não foi o primeiro.\"","        }","    },","     {","        \"a\": \"1842\",","        \"b\": \"1852\",","        \"c\": \"1862\",","        \"d\": \"1872\",","        \"r\": \"1852\",","        \"explicacoes\": {","            \"a\": \"1842 é uma data antes da fundação de Teresina.\",","            \"b\": \"1852 é o ano correto da fundação da cidade.\",","            \"c\": \"1862 foi 10 anos após a fundação de Teresina.\",","            \"d\": \"1872 é uma data posterior à fundação de Teresina.\"","        }","    },","    {","        \"a\": \"Parnaíba\",","        \"b\": \"Floriano\",","        \"c\": \"São Raimundo Nonato\",","        \"d\": \"Oeiras\",","        \"r\": \"Oeiras\",","        \"explicacoes\": {","            \"a\": \"Parnaíba é uma cidade importante, mas nunca foi capital do Piauí.\",","            \"b\": \"Floriano nunca foi capital do Piauí.\",","            \"c\": \"São Raimundo Nonato é conhecida pelos sítios arqueológicos, mas nunca foi capital.\",","            \"d\": \"Oeiras foi a primeira capital do Piauí até 1852.\"","        }","    },","    {","        \"a\": \"Ponte Juscelino Kubitschek\",","        \"b\": \"Ponte Estaiada João Isidoro França\",","        \"c\": \"Ponte Metálica\",","        \"d\": \"Ponte da Amizade\",","        \"r\": \"Ponte Estaiada João Isidoro França\",","        \"explicacoes\": {","            \"a\": \"Ponte Juscelino Kubitschek é uma ponte importante, mas está localizada em Brasília.\",","            \"b\": \"Ponte Estaiada João Isidoro França é o principal cartão postal de Teresina.\",","            \"c\": \"A Ponte Metálica é uma ponte histórica, mas não é considerada o símbolo mais famoso.\",","            \"d\": \"Ponte da Amizade existe, mas não é o símbolo mais conhecido de Teresina.\"","        }","    },","    {","        \"a\": \"Rio Poti\",","        \"b\": \"Rio Parnaíba\",","        \"c\": \"Rio São Francisco\",","        \"d\": \"Rio Gurguéia\",","        \"r\": \"Rio Poti\",","        \"explicacoes\": {","            \"a\": \"Rio Poti é um dos rios que corta Teresina, sendo o mais importante para a urbanização da cidade.\",","            \"b\": \"Rio Parnaíba é importante, mas o Rio Poti tem mais relevância dentro de Teresina.\",","            \"c\": \"O Rio São Francisco não passa por Teresina.\",","            \"d\": \"O Rio Gurguéia está localizado em outra região do Piauí.\"","        }","    }","","]","","for(let i = 0; i< dados_perguntas.length; i++){","    listaPerguntas.getChild(i).getChild(\"pergunta\").setString(dados_perguntas[i].pergunta);","}","","for(let i = 0; i< dados_respostas.length; i++){","    listaRespostas.getChild(i).getChild(\"a\").setString(dados_respostas[i].a);","    listaRespostas.getChild(i).getChild(\"b\").setString(dados_respostas[i].b);","    listaRespostas.getChild(i).getChild(\"c\").setString(dados_respostas[i].c);","    listaRespostas.getChild(i).getChild(\"d\").setString(dados_respostas[i].d);","    listaRespostas.getChild(i).getChild(\"r\").setString(dados_respostas[i].r);","","    // Exibindo a explicação da resposta correta e incorretas","    listaRespostas.getChild(i).getChild(\"explicacao_a\").setString(dados_respostas[i].explicacoes.a);","    listaRespostas.getChild(i).getChild(\"explicacao_b\").setString(dados_respostas[i].explicacoes.b);","    listaRespostas.getChild(i).getChild(\"explicacao_c\").setString(dados_respostas[i].explicacoes.c);","    listaRespostas.getChild(i).getChild(\"explicacao_d\").setString(dados_respostas[i].explicacoes.d);","","}","","total.setString(listaPerguntas.getChildrenCount());","","//textoPergunta[0].setString(listaPerguntas.getChild(0).getChild(\"pergunta\").getAsString());","","",""],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true},{"type":"BuiltinCommonInstructions::Link","include":{"includeConfig":0},"target":"Gerar_pergunta"},{"type":"BuiltinCommonInstructions::Standard","conditions":[],"actions":[{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["texto_total","Text","=","\"Total\" + NewLine() + VariableString(realizadas) +\" / \" + VariableString(total)"]},{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["acertos","Text","=","\"Acertos\" + NewLine() + VariableString(certas) +\" /0\""]}]}]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"SourisSurObjet"},"parameters":["botão_seguinte","","",""]},{"type":{"value":"MouseButtonReleased"},"parameters":["","Left"]}],"actions":[{"type":{"value":"TextContainerCapability::TextContainerBehavior::SetValue"},"parameters":["texto_total","Text","=","\"Total\" + NewLine() + VariableString(realizadas) +\" / \" + VariableString(total)"]},{"type":{"value":"TextContainerCapability::TextContain