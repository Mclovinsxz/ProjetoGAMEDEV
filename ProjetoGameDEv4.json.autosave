dard","conditions":[],"actions":[]},{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["// Variaveis","let lista_perguntas = runtimeScene.getVariables().get(\"listaPerguntas\");","let lista_respostas = runtimeScene.getVariables().get(\"listaRespostas\");","let realizadas = runtimeScene.getVariables().get(\"realizadas\");","let resposta = runtimeScene.getVariables().get(\"resposta\");","let explicacao_a = runtimeScene.getVariables().get(\"explicacao_a\");","let explicacao_b = runtimeScene.getVariables().get(\"explicacao_b\");","let explicacao_c = runtimeScene.getVariables().get(\"explicacao_c\");","let explicacao_d = runtimeScene.getVariables().get(\"explicacao_d\");","","","//Objetos","let texto_pergunta = runtimeScene.getObjects(\"texto_pergunta\");","let texto_resposta1 = runtimeScene.getObjects(\"texto_resposta1\");","let texto_resposta2 = runtimeScene.getObjects(\"texto_resposta2\");","let texto_resposta3 = runtimeScene.getObjects(\"texto_resposta3\");","let texto_resposta4 = runtimeScene.getObjects(\"texto_resposta4\");","//let texto_resposta_correta = runtimeScene.getObjects(\"texto_resposta_correta\");","","//numero aleatorio","let perguntaAleatoria = Math.floor(Math.random()*lista_perguntas.length);","","//adicionar texto na cena","texto_pergunta[0].setString(lista_perguntas.getChild(perguntaAleatoria).getChild(\"pergunta\").getAsString());","texto_resposta1[0].setString(lista_respostas.getChild(perguntaAleatoria).getChild(\"a\").getAsString());","texto_resposta2[0].setString(lista_respostas.getChild(perguntaAleatoria).getChild(\"b\").getAsString());","texto_resposta3[0].setString(lista_respostas.getChild(perguntaAleatoria).getChild(\"c\").getAsString());","texto_resposta4[0].setString(lista_respostas.getChild(perguntaAleatoria).getChild(\"d\").getAsString());","","//resposta alternativas","","explicacao_a.setString(lista_respostas.getChild(perguntaAleatoria).getChild(\"explicacao_a\").getAsString());","explicacao_b.setString(lista_respostas.getChild(perguntaAleatoria).getChild(\"explicacao_b\").getAsString());","explicacao_c.setString(lista_respostas.getChild(perguntaAleatoria).getChild(\"explicacao_c\").getAsString());","explicacao_d.setString(lista_respostas.getChild(perguntaAleatoria).getChild(\"explicacao_d\").getAsString());","//respostas_alternativas[0].setString(lista_respostas.getChild(perguntaAleatoria).getChild(\"explicacao_a\").getAsString());","//respostas_alternativas[1].setString(lista_respostas.getChild(perguntaAleatoria).getChild(\"explicacao_b\").getAsString());","//respostas_alternativas[2].setString(lista_respostas.getChild(perguntaAleatoria).getChild(\"explicacao_c\").getAsString());","//respostas_alternativas[3].setString(lista_respostas.getChild(perguntaAleatoria).getChild(\"explicacao_d\").getAsString());","","","//texto_resposta_correta[0].setString(lista_respostas.getChild(perguntaAleatoria).getChild(\"r\").getAsString());","","realizadas.setNumber(realizadas.getAsNumber()+1);","resposta.setString(lista_respostas.getChild(perguntaAleatoria).getChild(\"r\").getAsString());","","//retirar perguntas aleatorias da lista","lista_perguntas.removeAtIndex(perguntaAleatoria);","lista_respostas.removeAtIndex(perguntaAleatoria);","","",""],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}]},{"associatedLayout":"quiz_game","lastChangeTimeStamp":0,"name":"validar_resposta","events":[{"colorB":228,"colorG":176,"colorR":74,"creationTime":0,"name":"correta","source":"","type":"BuiltinCommonInstructions::Group","events":[],"parameters":[]},{"type":"BuiltinCommonInstructions::Standard","conditions":[{"type":{"value":"CompareTimer"},"parameters":["","\"correta\"",">=","0.1"]},{"type":{"value":"BuiltinCommonInstructions::Once"},"parameters":[]}],"actions":[{"type":{"value":"RemoveTimer"},"parameters":["","\"correta\""]},{"type":{"value":"Montre"},"parameters":["balao_texto",""]},{"type":{"value":"Montre"},"parameters":["texto_personagem",""]},{"type":{"value":"Montre"},"parameters":["botão